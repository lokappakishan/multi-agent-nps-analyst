```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Build and distribution
build/
dist/
*.egg-info/

# IDE and editor settings
.vscode/
.idea/

# macOS files
.DS_Store

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
```